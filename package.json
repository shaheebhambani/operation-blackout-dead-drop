{
  "name": "operation-blackout-dead-drop",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm install --prefix client",
    "dev": "concurrently -n api,web \"node --watch server/index.js\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "start": "node server/index.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
